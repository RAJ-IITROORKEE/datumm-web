# Same Clerk instance as the existing DATUMM account host. Never commit real values.
# Both keys must be nonblank; missing/partial configuration keeps sign-in unavailable.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Separate task service: exact HTTPS root origin; server-only.
# No credentials, path, query or fragment. Configuration is not a health check.
# Development uses http://localhost:3001; service authorization is origin-specific.
ORCHESTRATOR_URL=
