+                'children':{'type':'array','minItems':1,'maxItems':8,'items':{'type':'string','minLength':1,'maxLength':32}}},
+            'required':['id','type'],'additionalProperties':False}}},
+    'required':['rootId','nodes'],'additionalProperties':False}
+
+
+def _cells(line):
+    value=_trim(line)
+    if value.startswith('|'): value=value[1:]
+    if value.endswith('|') and (len(value)<2 or value[-2]!='\\'): value=value[:-1]
+    result=[]; cell=''; i=0
+    while i<len(value):
+        if value[i:i+2]=='\\|': cell+='|'; i+=2; continue
+        if value[i]=='|': result.append(_trim(cell)); cell=''
+        else: cell+=value[i]
+        i+=1
+    return result+[_trim(cell)]
+
+
+def validate(proposal, answer):
+    """Return exact web-compatible tree and answer hash, or None; never alter answer."""
+    try:
+        if not isinstance(answer,str) or len(answer.encode('utf-16-le'))//2>100000: return None
+        if not isinstance(proposal,dict) or set(proposal)!={'rootId','nodes'}: return None
+        if len(json.dumps(proposal,ensure_ascii=False,separators=(',',':'),allow_nan=False).encode('utf-8'))>24576: return None
+        nodes=proposal['nodes']; root=proposal['rootId']
+        if not isinstance(root,str) or not 1<=len(root)<=32 or not isinstance(nodes,list) or not 1<=len(nodes)<=24: return None
+        by_id={}
+        for node in nodes:
+            if not isinstance(node,dict) or not isinstance(node.get('id'),str) or not 1<=len(node['id'])<=32 or node['id'] in by_id: return None
+            by_id[node['id']]=node
+        # UTF-16 positions are web String indices, not Python code-point indices.
+        boundaries={0:0}; position=0
+        for i,char in enumerate(answer):
+            position+=2 if ord(char)>0xffff else 1
+            boundaries[position]=i+1
+        visited=set(); total=0
+        def read(span,whole=False,label=False):
+            nonlocal total
+            if not isinstance(span,dict) or set(span)!={'start','end'}: raise ValueError()
+            a=span['start']; z=span['end']
+            if type(a)!=int or type(z)!=int or a<0 or z<=a or z-a>1200 or a not in boundaries or z not in boundaries: raise ValueError()
+            x,y=boundaries[a],boundaries[z]; value=answer[x:y]; total+=z-a
+            if not _trim(value) or total>8000: raise ValueError()
+            if whole and ((x>0 and not re.search(r'\r?\n[ \t]*\r?\n$',answer[:x])) or (y<len(answer) and not re.match(r'\r?\n[ \t]*\r?\n',answer[y:]))): raise ValueError()
+            if label and (z-a>120 or '\n' in value or '\r' in value or (x>0 and answer[x-1]!='\n') or (y<len(answer) and not re.match(r'\r?\n',answer[y:]))): raise ValueError()
+            return value
+        def visit(key,depth=0):
+            if depth>4 or key in visited or key not in by_id: raise ValueError()
+            visited.add(key); item=by_id[key]; kind=item.get('type')
+            field={'text':'text','table':'source','bars':'source','flow':'source','details':'label'}.get(kind)
+            expected={'id','type'}|({field} if field else set())|({'children'} if kind in ('stack','grid','details') else set())
+            if kind not in ('text','stack','grid','details','table','bars','flow') or set(item)!=expected: raise ValueError()
+            out={'type':kind}
+            if kind in ('stack','grid','details'):
+                children=item['children']
+                if not isinstance(children,list) or not 1<=len(children)<=(2 if kind=='grid' else 8) or any(not isinstance(c,str) for c in children): raise ValueError()
+                if kind=='details': read(item['label'],label=True); out['label']=item['label']
+                out['children']=[visit(c,depth+1) for c in children]
+                return out
+            block=read(item[field],whole=True); out[field]=item[field]
+            if kind in ('table','bars'):
+                lines=re.split(r'\r?\n',block)
+                if not 3<=len(lines)<=14 or any(not _trim(line).startswith('|') or not _trim(line).endswith('|') for line in lines): raise ValueError()
+                columns=_cells(lines[0]); div=_cells(lines[1]); rows=[_cells(line) for line in lines[2:]]
+                if not 1<=len(columns)<=6 or len(div)!=len(columns) or any(not re.fullmatch(r':?-{3,}:?',_trim(x)) for x in div) or any(not _trim(x) for x in columns) or any(len(r)!=len(columns) or any(not _trim(x) for x in r) for r in rows): raise ValueError()
+                if kind=='bars':
+                    if len(columns)!=2: raise ValueError()
+                    for _,number in rows:
+                        if not re.fullmatch(r'(?:0|[1-9][0-9]*)(?:\.[0-9]+)?',number) or not math.isfinite(float(number)) or float(number)>1e12: raise ValueError()
+            if kind=='flow':
+                lines=re.split(r'\r?\n',block); labels=set(); edges=set()
+                if len(lines)>20: raise ValueError()
+                for line in lines:
+                    parts=[_trim(s) for s in re.split(rf'{_JS_WS}+(?:->|→){_JS_WS}+',line)]
+                    if not 2<=len(parts)<=12 or any(not s or len(s.encode('utf-16-le'))//2>120 or re.search(r'[<>\r\n]',s) for s in parts): raise ValueError()
+                    labels.update(parts); edges.update(zip(parts,parts[1:]))
+                if len(labels)>12 or len(edges)>20: raise ValueError()
+            return out
+        tree=visit(root)
+        if len(visited)!=len(nodes): return None
+        return {'schemaVersion':1,'kind':'illustrative-explanation','answerHash':hashlib.sha256(answer.encode('utf-8')).hexdigest(),'root':tree}
+    except (ValueError,TypeError,KeyError,OverflowError,UnicodeError,RecursionError):
+        return None
+
+
+def validate_stored(value, answer):
+    """Recheck stored nested data and its exact answer binding before projection."""
+    if not isinstance(value,dict) or set(value)!={'schemaVersion','kind','answerHash','root'}: return None
+    if type(value.get('schemaVersion')) is not int or value.get('schemaVersion')!=1 or value.get('kind')!='illustrative-explanation': return None
+    nodes=[]; seen=set()
+    def flatten(item,depth=0):
+        if not isinstance(item,dict) or id(item) in seen or depth>4 or len(nodes)>=24: raise ValueError()
+        seen.add(id(item)); ident=str(len(nodes)); entry={**item,'id':ident}; nodes.append(entry)
+        if 'children' in item:
+            if not isinstance(item['children'],list): raise ValueError()
+            entry['children']=[flatten(child,depth+1) for child in item['children']]
+        return ident
+    try:
+        root=flatten(value['root']); rebuilt=validate({'rootId':root,'nodes':nodes},answer)
+        return rebuilt if rebuilt==value else None
+    except (ValueError,TypeError,KeyError,RecursionError): return None
