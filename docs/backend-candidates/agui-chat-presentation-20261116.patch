+def example():
+    answer='😀 Sequence\n\n| Stage | Value |\n| --- | --- |\n| Plan | 2 |'
+    begin=answer.index('| Stage'); end=len(answer)
+    proposal={'rootId':'layout','nodes':[
+        {'id':'layout','type':'stack','children':['title','table']},
+        {'id':'title','type':'text','text':{'start':0,'end':offset(answer[:answer.index('\n\n')])}},
+        {'id':'table','type':'bars','source':{'start':offset(answer[:begin]),'end':offset(answer[:end])}}]}
+    return answer,proposal
+
+
+def test_valid_utf16_and_stored_revalidation():
+    answer,proposal=example(); value=c.validate(proposal,answer)
+    assert value and value['answerHash']==hashlib.sha256(answer.encode()).hexdigest()
+    assert value['root']['children'][1]['type']=='bars'
+    assert c.validate_stored(value,answer)==value
+    assert c.validate_stored(value,answer+'!') is None
+    broken=deepcopy(proposal); broken['nodes'][1]['text']['start']=1
+    assert c.validate(broken,answer) is None  # Inside the emoji surrogate pair.
+
+
+@pytest.mark.parametrize('mutation',['cycle','unused','unknown','extra','too_deep','bad_table','bad_number','oversize'])
+def test_rejects_invalid_optional_layout(mutation):
+    answer,p=example()
+    if mutation=='cycle': p['nodes'][0]['children']=['layout']
+    elif mutation=='unused': p['nodes'].append({'id':'hidden','type':'text','text':{'start':0,'end':2}})
+    elif mutation=='unknown': p['nodes'][1]['type']='script'
+    elif mutation=='extra': p['nodes'][1]['url']='https://example.com'
+    elif mutation=='too_deep':
+        p={'rootId':'n0','nodes':[{'id':f'n{i}','type':'stack','children':[f'n{i+1}']} for i in range(5)]+[{'id':'n5','type':'text','text':{'start':0,'end':2}}]}
+    elif mutation=='bad_table': answer=answer.replace('| --- | --- |','| --- | ? |')
+    elif mutation=='bad_number': answer=answer.replace('| Plan | 2 |','| Plan | NaN |')
