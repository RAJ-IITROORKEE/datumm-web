+import copy
+import unittest
+import chat_composition
+import task_controller as tc
+
+class ProjectionTests(unittest.TestCase):
+    def setUp(self):
+        self.text='A 😀 room has daylight.'
+        layout=chat_composition.validate({'rootId':'a','nodes':[{'id':'a','type':'text','text':{'start':0,'end':len(self.text.encode('utf-16-le'))//2}}]},self.text)
+        self.run={'_id':'run','owner':'owner','task_id':'task','status':'completed','data':{'answer':self.text,'agent_result':{'status':'completed','answer':self.text,'observations':[{'kind':'response_ready'}]},'agent_composition':layout}}
+        self.command={'id':'turn','state':'applied','resultExecutionId':'run','acceptedAt':'2026','command':{'type':'submit','prompt':'Plan'}}
+        self.events=[{'taskId':'task','executionId':'run','sequence':1,'stage':'answer','detail':self.text},{'taskId':'task','executionId':'run','sequence':2,'stage':'completed','detail':'Agent finished.'}]
+    def project(self):
+        return tc.conversation([self.run],[self.command],'task','owner',['run'],self.events,3)[-1]
+    def test_bound_unicode(self):
+        item=self.project()
+        self.assertEqual(item['completion']['completionSequence'],2)
+        self.assertEqual(item['presentation']['composition']['root']['text']['end'],len(self.text)+1)
+    def test_bad_evidence_falls_back(self):
+        for case in ('owner','task','run_status','result_status','result_answer','response','command','answer','complete','order','duplicate','contradiction'):
+            with self.subTest(case=case):
+                self.setUp()
+                if case=='owner': self.run['owner']='foreign'
+                if case=='task': self.run['task_id']='foreign'
+                if case=='run_status': self.run['status']='running'
+                if case=='result_status': self.run['data']['agent_result']['status']='partial'
+                if case=='result_answer': self.run['data']['agent_result']['answer']='stale'
+                if case=='response': self.run['data']['agent_result']['observations']=[]
+                if case=='command': self.command['state']='accepted'
+                if case=='answer': self.events.pop(0)
+                if case=='complete': self.events.pop()
+                if case=='order': self.events[0]['sequence'],self.events[1]['sequence']=2,1
+                if case=='duplicate': self.events.append(copy.deepcopy(self.events[0]))
+                if case=='contradiction': self.events.append({'taskId':'task','executionId':'run','sequence':3,'stage':'paused_recovery','detail':'Paused'})
+                item=self.project()
+                self.assertEqual(item['answer'],self.text)
+                self.assertNotIn('completion',item)
+                self.assertNotIn('presentation',item)
+    def test_ambiguous_command_and_invalid_composition(self):
+        self.assertNotIn('completion',tc.conversation([self.run],[self.command,copy.deepcopy(self.command)],'task','owner',['run'],self.events,3)[-1])
+        self.run['data']['agent_composition']['root']['text']['end']-=1
+        item=self.project()
+        self.assertIn('completion',item)
+        self.assertNotIn('presentation',item)
+    def test_later_wait_or_reconciliation_vetoes_completed_proof(self):
+        for stage in ('awaiting_approval', 'needs_input', 'waiting', 'waiting_for_input', 'reconciling'):
+            with self.subTest(stage=stage):
+                self.setUp()
+                self.events.append({'taskId':'task','executionId':'run','sequence':3,'stage':stage,'detail':'Waiting'})
+                item=self.project()
+                self.assertNotIn('completion',item)
+                self.assertNotIn('presentation',item)
+
+    def test_long_answer_prefix(self):
+        answer='x'*2100
+        self.run['data']['answer']=self.run['data']['agent_result']['answer']=answer
+        self.events[0]['detail']=answer[:2000]
+        self.assertIn('completion',self.project())
+        self.events[0]['detail']='y'+answer[1:2000]
+        self.assertNotIn('completion',self.project())
+
+if __name__=='__main__': unittest.main()
