+def explicit_generation_veto(prompt, answered_footprint=False):
+    """Recognize a narrow current-turn refusal; unknown wording stays unknown."""
+    from brief_interpreter import design_text
+    text=design_text({'text':prompt or ''})
+    text=re.sub(r'''["“][^"”]*["”]|(?<!\w)'[^']*'(?!\w)''',lambda m:' '*len(m[0]),text)
+    noun=r'(?:floor[ -]plans?|plans?|drawings?|designs?|layouts?|concepts?|geometry)'
+    action=r'(?:generate|create|produce|draw|make)'
+    pattern=rf"\b(?P<negative>do not|don't|never|no)\s+(?:(?:{action})\s+(?:or\s+(?:{action})\s+)?)?(?:(?:a|an|the|any|new|floor)\s+)*{noun}\b|\b(?P<positive>{action})\s+(?:(?:a|an|the|any|new|floor)\s+)*{noun}\b"
+    veto=False
+    for m in re.finditer(pattern,text,re.I):
+        clause=re.split(r'[.!?;]',text[:m.start()])[-1]
+        tail=re.split(r'[.!?;]',text[m.end():])[0]
+        if re.search(r'\b(?:example|for instance)\b',clause,re.I): continue
+        if m.group('negative'):
+            if answered_footprint and re.match(r'\s+until\s+i\s+answer\s+those\s+questions\b',tail,re.I): continue
+            veto=True
+        elif not re.search(r"\b(?:do not|don't|never|without)\s+$",clause,re.I):
+            veto=False
+    return veto
