+def _footprint_question_condition(prompt):
+    from brief_interpreter import design_text
+    text=design_text({'text':prompt or ''})
+    text=re.sub(r'''["“][^"”]*["”]|(?<!\w)'[^']*'(?!\w)''',lambda m:' '*len(m[0]),text)
+    return bool(re.search(r'\bfirst\s+ask\s+me\s+together\b[^.!?;]{0,180}\bfootprint\s+width\s+and\s+depth\b[^.!?;]{0,100}\bentrance\s+side\b',text,re.I)
+        and re.search(r'\buntil\s+i\s+answer\s+those\s+questions\b',text,re.I))
+
+
+async def _answered_footprint_condition(state):
+    """Accept only the exact current grouped receipt and its rebuilt source facts."""
+    if not _footprint_question_condition(state.get('prompt','')): return False
+    brief=state.get('interpreted_brief') or {}
+    if brief.get('unresolved'): return False
+    run=await storage.db.runs.find_one({'_id':state['run_id'],'owner':state['owner']})
+    data=(run or {}).get('data') or {}; receipt=data.get('agent_reply_receipt')
+    if not isinstance(receipt,dict) or not receipt.get('questionId'): return False
+    version=receipt.get('version'); answers=receipt.get('answers')
+    if (type(version) is not int or version<1 or type(data.get('agent_question_version')) is not int
+        or data.get('agent_question_version')!=version
+        or receipt not in (data.get('agent_answers') or []) or not isinstance(answers,list) or len(answers)!=2): return False
+    by_id={a.get('questionId'):a for a in answers if isinstance(a,dict)}
+    expected={'dimensions':'What are the building footprint width and depth, including units?',
+              'entry':'Which side should the entrance face?'}
+    if set(by_id)!=set(expected) or any(by_id[k].get('question')!=q for k,q in expected.items()): return False
+    if not any(o.get('kind')=='user_answer' and o.get('questionVersion')==version and o.get('answers')==answers
+               for o in state.get('observations',[]) if isinstance(o,dict)): return False
+    sources={s.get('id'):s for s in brief.get('sources',[]) if isinstance(s,dict)}
+    for key in expected:
+        answer=by_id[key]; src=sources.get('answer:'+key) or {}; value=answer.get('value')
+        if not isinstance(value,str): return False
+        value+=(' '+answer['unit'] if answer.get('unit') and not answer.get('optionId') else '')
+        if (src.get('provenance')!='answered' or src.get('field')!=key or src.get('questionVersion')!=version
+            or src.get('question')!=expected[key] or src.get('text')!=value): return False
+    return (any(d.get('role')=='footprint' and d.get('sourceId')=='answer:dimensions' for d in brief.get('dimensions',[]))
+            and (brief.get('values',{}).get('entry') or {}).get('sourceId')=='answer:entry')
+
